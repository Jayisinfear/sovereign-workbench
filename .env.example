# Sovereign AI Workbench - Environment Configuration
# Copy this file to .env and customize as needed.

# Ollama model to use (must be pulled first: ollama pull <model>)
MODEL_NAME=qwen2.5:7b

# Path to your local Ollama data directory
# Windows: C:/Users/<YourName>/.ollama
# Linux/Mac: ~/.ollama
OLLAMA_DATA=~/.ollama